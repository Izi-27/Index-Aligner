# Index Aligner — frontend environment variables (template)
# Copy this file to .env and fill in the values. Do NOT commit .env.
# Vite only exposes vars prefixed with VITE_ to client code (import.meta.env.*)

# SoSoValue API (used for live index prices / drift detection)
VITE_SOSOVALUE_API_BASE=https://api.sosovalue.com
VITE_SOSOVALUE_API_KEY=your-sosovalue-api-key-here
