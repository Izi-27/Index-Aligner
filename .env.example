# Index Aligner — environment variables (template)
# Copy this file to .env and fill in the values. Do NOT commit .env.

# --- Server-side (Netlify Functions) ---
# SoSoValue API key — SECRET. Read by the serverless functions via process.env.
# It is intentionally NOT prefixed with VITE_ (that would expose it in the
# public client bundle). Leave blank to run the app on mock data.
# In production, set this in the Netlify UI (Site settings → Environment variables).
SOSOVALUE_API_KEY=your-sosovalue-api-key-here
SOSOVALUE_API_BASE=https://openapi.sosovalue.com/openapi/v1

# On-chain holdings (SSI Protocol) — JSON-RPC endpoint for reading wallet
# positions. Leave blank to serve demo positions; set to enable real reads.
SSI_RPC_URL=https://your-rpc-endpoint

# Execution (SoDEX). SAFETY GUARD: /api/execute only places real, fund-moving
# trades when BOTH a key is present AND EXECUTION_ENABLED=true. Otherwise it
# simulates (no on-chain effect). Leave disabled unless you truly intend to trade.
SODEX_API_KEY=your-sodex-api-key-here
EXECUTION_ENABLED=false
